# Google Gemini API Configuration (OpenAI Compatible API)
GEMINI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Speech-To-Text Configuration (Whisper Compatible API)
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=mock_key
STT_MODEL=whisper-1

# Application Settings
CONTEXT_DUMP_DIR=../context-dump
DATABASE_URL=sqlite:///./mental_health.db
SYSTEM_PROMPT=You are an empathetic, intuitive Mental Health & Wellbeing AI Companion. You listen actively, provide supportive guidance, and help users track and improve their mental wellbeing. Use the provided context files and user database document to personalize your advice.
